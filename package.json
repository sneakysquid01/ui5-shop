{
  "name": "ui5-shop",
  "version": "1.0.0",
  "description": "UI5 Shop - product catalogue with cart and checkout",
  "private": true,
  "scripts": {
    "start": "ui5 serve -o index.html",
    "start:mobile": "ui5 serve --accept-remote-connections",
    "test": "ui5 serve -o test/testsuite.qunit.html",
    "build": "ui5 build --all --clean-dest"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.71",
    "ui5-middleware-livereload": "^3.4.0",
    "ui5-middleware-serveframework": "^3.8.2",
    "ui5-middleware-simpleproxy": "^3.9.0"
  }
}
