<mvc:View
   controllerName="ui5.shop.controller.NotFound"
   xmlns="sap.m"
   xmlns:mvc="sap.ui.core.mvc">
   <Page
      title="{i18n>notFoundPageTitle}"
      showNavButton="true"
      navButtonPress=".onNavBack">
      <content>
         <IllustratedMessage
            illustrationType="sapIllus-PageNotFound"
            title="{i18n>notFoundTitle}"
            description="{i18n>notFoundText}">
            <additionalContent>
               <Button
                  text="{i18n>backToShop}"
                  type="Emphasized"
                  press=".onNavToShop"/>
            </additionalContent>
         </IllustratedMessage>
      </content>
   </Page>
</mvc:View>