<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core">
   <VBox
      class="sapUiSmallMarginTop"
      core:require="{
         Formatter: 'ui5/shop/model/formatter'
      }">
      <HBox justifyContent="SpaceBetween" alignItems="Center">
         <Text text="{i18n>cartSubtotal}"/>
         <ObjectNumber number="{
            path: 'cart>/subtotal',
            formatter: 'Formatter.price'
         }"/>
      </HBox>
      <HBox
         class="sapUiTinyMarginTop"
         justifyContent="SpaceBetween"
         alignItems="Center">
         <Text text="{i18n>cartTax}"/>
         <ObjectNumber number="{
            path: 'cart>/tax',
            formatter: 'Formatter.price'
         }"/>
      </HBox>
      <HBox
         class="sapUiSmallMarginTop"
         justifyContent="SpaceBetween"
         alignItems="Center">
         <Title
            text="{i18n>cartGrandTotal}"
            level="H3"/>
         <ObjectNumber
            class="sapMObjectNumberLarge"
            number="{
               path: 'cart>/total',
               formatter: 'Formatter.price'
            }"
            emphasized="true"/>
      </HBox>
   </VBox>
</core:FragmentDefinition>