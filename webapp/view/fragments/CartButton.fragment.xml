<core:FragmentDefinition
   xmlns="sap.m"
   xmlns:core="sap.ui.core">
   <Button
      icon="sap-icon://cart"
      type="Transparent"
      tooltip="{i18n>cartButtonTooltip}"
      press=".onCartPress">
      <customData>
         <BadgeCustomData
            key="badge"
            value="{= '' + ${cart>/itemCount} }"
            visible="{= ${cart>/itemCount} > 0 }"/>
      </customData>
   </Button>
</core:FragmentDefinition>